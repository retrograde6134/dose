    <string name="schedule_every_day">Every day</string>
    <plurals name="schedule_every_n_days">
        <item quantity="one">Every day</item>
        <item quantity="other">Every %d days</item>
    </plurals>
    <!-- %2$s is a list of weekdays, e.g. "Mon, Thu" -->
    <plurals name="schedule_weekdays_every_n_weeks">
        <item quantity="one">%2$s</item>
        <item quantity="other">%2$s, every %1$d weeks</item>
    </plurals>
